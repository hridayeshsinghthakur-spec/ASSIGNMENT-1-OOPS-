#include <iostream>
#include <string>
using namespace std;

class Item {
private:
    string itemName;
    double price;

public:
    void setData(string itemName, double price) {
        this->itemName = itemName;
        this->price = price;
    }

    void display() {
        cout << "Item: " << this->itemName << " | Price: " << this->price << endl;
    }
};

int main() {
    Item obj;
    Item* ptr = &obj;

    obj.setData("Keyboard", 25.50);
    cout << "Accessing via Dot Operator (.):" << endl;
    obj.display();

    ptr->setData("Mouse", 15.75);
    cout << "\nAccessing via Arrow Operator (->):" << endl;
    ptr->display();

    cout << "\nAccessing via Pointer Dereferencing (*ptr). :" << endl;
    (*ptr).display();

    return 0;
}
