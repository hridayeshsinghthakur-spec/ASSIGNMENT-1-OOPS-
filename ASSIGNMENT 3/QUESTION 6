#include <iostream>
using namespace std;

inline int cube(int n) {
    return n * n * n;
}

int main() {
    int num;

    cout << "Enter a number to find its cube: ";
    cin >> num;

    cout << "The cube of " << num << " is: " << cube(num) << endl;

    int anotherNum = 5;
    cout << "The cube of " << anotherNum << " is: " << cube(anotherNum) << endl;

    return 0;
}
