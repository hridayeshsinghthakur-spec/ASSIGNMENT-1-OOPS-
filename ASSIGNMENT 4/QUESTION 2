#include <iostream>
using namespace std;

class Rectangle {
private:
    int length;
    int breadth;

public:
    Rectangle(int l = 0, int b = 0) {
        length = l;
        breadth = b;
        cout << "Constructor called. Dimensions: " << length << "x" << breadth << endl;
    }

    Rectangle(int side) {
        length = side;
        breadth = side;
        cout << "Square Constructor called. Side: " << length << endl;
    }

    ~Rectangle() {
        cout << "Destructor called for Rectangle " << length << "x" << breadth << endl;
    }

    int calculateArea() {
        return length * breadth;
    }
};

int main() {
    Rectangle rects[3] = {
        Rectangle(),      
        Rectangle(5),     
        Rectangle(10, 20) 
    };

    cout << "\n--- Calculating Areas ---" << endl;
    for (int i = 0; i < 3; i++) {
        cout << "Area of Object " << i << ": " << rects[i].calculateArea() << endl;
    }
    cout << "-------------------------\n" << endl;

    return 0;
}
