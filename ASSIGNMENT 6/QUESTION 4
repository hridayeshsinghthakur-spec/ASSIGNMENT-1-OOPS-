#include <iostream>
using namespace std;

class ClassB;
class ClassA
{
    int a;

public:
    ClassA(int x)
    {
        a = x;
    }

    friend int add(ClassA, ClassB);
};

class ClassB
{
    int b;

public:
    ClassB(int y)
    {
        b = y;
    }

  
    friend int add(ClassA, ClassB);
};


int add(ClassA obj1, ClassB obj2)
{
    return obj1.a + obj2.b;
}

int main()
{
    ClassA obj1(10);
    ClassB obj2(20);

    int result = add(obj1, obj2);

    cout << "Sum = " << result << endl;

    return 0;
}
