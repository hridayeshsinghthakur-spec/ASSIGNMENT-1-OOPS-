#include <iostream>
using namespace std;

class polygon
{
protected:
    int width, height;

public:
    void set_value(int w, int h)
    {
        width = w;
        height = h;
    }

    
    virtual int calculate_area()
    {
        return 0;
    }
};


class Rectangle : public polygon
{
public:
    int calculate_area()
    {
        return width * height;
    }
};


class Triangle : public polygon
{
public:
    int calculate_area()
    {
        return 0.5 * width * height;
    }
};

int main()
{
    polygon *p;   

    Rectangle r;
    Triangle t;

   
    p = &r;
    p->set_value(10, 5);
    cout << "Rectangle Area = " << p->calculate_area() << endl;

  
    p = &t;
    p->set_value(10, 5);
    cout << "Triangle Area = " << p->calculate_area() << endl;

    return 0;
}
