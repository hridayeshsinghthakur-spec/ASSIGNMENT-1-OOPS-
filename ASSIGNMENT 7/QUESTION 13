#include <iostream>
#include <cmath>
using namespace std;

class Polar
{
public:
    float r, theta;

    Polar(float radius, float angle)
    {
        r = radius;
        theta = angle;
    }
};

class Cartesian
{
    float x, y;

public:
    // Conversion constructor
    Cartesian(Polar p)
    {
        x = p.r * cos(p.theta);
        y = p.r * sin(p.theta);
    }

    void show()
    {
        cout << "x = " << x << ", y = " << y << endl;
    }
};

int main()
{
    Polar p(10, 0.5);   // radius = 10, angle in radians

    Cartesian c = p;    // UDT → UDT conversion

    c.show();

    return 0;
}
