#include <iostream>
using namespace std;

class SafeArray
{
    int arr[5];

public:
    // Constructor to initialize values
    SafeArray()
    {
        for(int i = 0; i < 5; i++)
            arr[i] = i * 10;
    }

    // Overload [] operator
    int& operator[](int index)
    {
        if(index < 0 || index >= 5)
        {
            cout << "Error: Index out of bounds!" << endl;
            exit(0);  // terminate program
        }
        return arr[index];
    }
};

int main()
{
    SafeArray s;

    cout << "Element at index 2: " << s[2] << endl;

    cout << "Trying invalid index:\n";
    cout << s[10];   // out of bounds

    return 0;
}
