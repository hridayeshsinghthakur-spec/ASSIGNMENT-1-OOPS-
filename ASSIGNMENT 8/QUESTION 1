#include <iostream>
using namespace std;

template <typename T>
void swapValues(T &a, T &b)
{
    T temp;
    temp = a;
    a = b;
    b = temp;
}

int main()
{
    int x = 5, y = 10;
    swapValues(x, y);

    cout << "After swap (int): " << x << " " << y << endl;

    float p = 1.5, q = 2.5;
    swapValues(p, q);

    cout << "After swap (float): " << p << " " << q << endl;

    return 0;
}
