#include <iostream>
using namespace std;

template <typename T>
T findMin(T arr[], int size)
{
    T min = arr[0];  

    for(int i = 1; i < size; i++)
    {
        if(arr[i] < min)
        {
            min = arr[i];
        }
    }

    return min;
}

int main()
{
    int arr1[] = {5, 2, 9, 1, 7};
    int size1 = 5;

    cout << "Minimum (int): " << findMin(arr1, size1) << endl;

    float arr2[] = {2.5, 1.1, 3.6, 0.9};
    int size2 = 4;

    cout << "Minimum (float): " << findMin(arr2, size2) << endl;

    return 0;
}
