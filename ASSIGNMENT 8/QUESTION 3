#include <iostream>
using namespace std;

template <typename T>
void bubbleSort(T arr[], int size)
{
    for(int i = 0; i < size - 1; i++)
    {
        for(int j = 0; j < size - i - 1; j++)
        {
            if(arr[j] > arr[j + 1])
            {
                T temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
}

int main()
{
    int arr1[] = {5, 2, 9, 1, 7};
    int size1 = 5;

    bubbleSort(arr1, size1);

    cout << "Sorted int array: ";
    for(int i = 0; i < size1; i++)
        cout << arr1[i] << " ";

    cout << endl;

    float arr2[] = {2.5, 1.1, 3.6, 0.9};
    int size2 = 4;

    bubbleSort(arr2, size2);

    cout << "Sorted float array: ";
    for(int i = 0; i < size2; i++)
        cout << arr2[i] << " ";

    return 0;
}
