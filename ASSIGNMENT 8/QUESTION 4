#include <iostream>
using namespace std;

template <typename T>
int linearSearch(T arr[], int size, T key)
{
    for(int i = 0; i < size; i++)
    {
        if(arr[i] == key)
        {
            return i;   
        }
    }
    return -1;  
}

int main()
{
    int arr1[] = {5, 2, 9, 1, 7};
    int size1 = 5;

    int result1 = linearSearch(arr1, size1, 9);

    if(result1 != -1)
        cout << "Element found at index: " << result1 << endl;
    else
        cout << "Element not found" << endl;

    float arr2[] = {2.5, 1.1, 3.6, 0.9};
    int size2 = 4;

    int result2 = linearSearch(arr2, size2, 3.6);

    if(result2 != -1)
        cout << "Element found at index: " << result2 << endl;
    else
        cout << "Element not found" << endl;

    return 0;
}
