#include <iostream>
using namespace std;


template <typename T>
void process(T a)
{
    cout << "Single parameter: " << a << endl;
}


template <typename T>
void process(T a, T b)
{
    cout << "Two parameters (same type): " << a << " , " << b << endl;
}
template <typename T, typename U>
void process(T a, U b)
{
    cout << "Two parameters (different types): " << a << " , " << b << endl;
}

int main()
{
    process(10);           
    process(5, 7);          
    process(3, 4.5);        
    process('A', 100);      

    return 0;
}
