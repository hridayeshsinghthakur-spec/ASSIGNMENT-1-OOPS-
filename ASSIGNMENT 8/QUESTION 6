#include <iostream>
using namespace std;

template <typename T>
class Stack
{
    T arr[100];   // array to store elements
    int top;      // top of stack

public:
    Stack()
    {
        top = -1;  // initially stack is empty
    }

    void push(T x)
    {
        if(top == 99)
        {
            cout << "Stack Overflow\n";
            return;
        }
        arr[++top] = x;
        cout << x << " pushed into stack\n";
    }

    void pop()
    {
        if(top == -1)
        {
            cout << "Stack Underflow\n";
            return;
        }
        cout << arr[top] << " popped from stack\n";
        top--;
    }

    void display()
    {
        if(top == -1)
        {
            cout << "Stack is empty\n";
            return;
        }

        cout << "Stack elements: ";
        for(int i = top; i >= 0; i--)
            cout << arr[i] << " ";
        cout << endl;
    }
};

int main()
{
    Stack<int> s1;   // stack of integers

    s1.push(10);
    s1.push(20);
    s1.push(30);

    s1.display();

    s1.pop();
    s1.display();

    Stack<float> s2; // stack of floats

    s2.push(1.1);
    s2.push(2.2);

    s2.display();

    return 0;
}
