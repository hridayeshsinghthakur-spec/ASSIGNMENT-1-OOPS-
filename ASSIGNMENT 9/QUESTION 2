#include <iostream>
#include <fstream>
using namespace std;

int countAlphabets()
{
    ifstream file("NOTES.TXT");   

    if(!file)
    {
        cout << "Error opening file!" << endl;
        return 0;
    }

    char ch;
    int count = 0;

    while(file.get(ch))   
    {
        if( (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') )
        {
            count++;     
        }
    }

    file.close();
    return count;
}

int main()
{
    int total = countAlphabets();

    cout << "Number of alphabets in file = " << total << endl;

    return 0;
}
