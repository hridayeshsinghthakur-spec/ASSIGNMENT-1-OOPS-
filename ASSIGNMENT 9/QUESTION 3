#include <iostream>
#include <fstream>
using namespace std;

int main()
{
    ifstream fin("SOURCE.TXT");    
    ofstream fout("DEST.TXT");     

    if(!fin || !fout)
    {
        cout << "Error opening file!" << endl;
        return 1;
    }

    char ch;

    
    while(fin.get(ch))
    {
        fout.put(ch);
    }

    fin.close();
    fout.close();

    cout << "File copied successfully." << endl;

    return 0;
}
