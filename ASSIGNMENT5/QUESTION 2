#include <iostream>
using namespace std;

class Base {
protected:
    int score;
};

class Result : public Base {
public:
    void setScore(int s) {
        score = s;
    }

    void display() {
        cout << "Your score is: " << score << endl;
    }
};

int main() {
    Result obj;
    obj.setScore(95);
    obj.display();

    return 0;
}
