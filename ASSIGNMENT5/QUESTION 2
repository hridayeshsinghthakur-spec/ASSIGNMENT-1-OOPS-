#include <iostream>
#include <string>

using namespace std;

class Employee {
protected:
    double salary;

public:
    void setBaseSalary(double s) {
        salary = s;
    }
};

class Manager : public Employee {
private:
    double bonus;

public:
    void setBonus(double b) {
        bonus = b;
    }

    void displayTotalCompensation() {
        
        double total = salary + bonus;
        cout << "Base Salary: " << salary << endl;
        cout << "Bonus: " << bonus << endl;
        cout << "Total Pay: " << total << endl;
    }
};

int main() {
    Manager m1;

    m1.setBaseSalary(50000);
    m1.setBonus(15000);

    cout << " Manager Details" << endl;
    m1.displayTotalCompensation();

     

    return 0;
}
