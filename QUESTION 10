//using if-else  

#include <iostream>
using namespace std;

int main()
{
    int num;

    cout << "Enter a number: "; 
    cin >> num;

    if (num % 2 == 0)
        cout << "Number is Even";
    else
        cout << "Number is Odd";

    return 0;
}


//using conditional Operator

#include <iostream>
using namespace std;

int main()
{
    int num;

    cout << "Enter a number: ";
    cin >> num;

    (num % 2 == 0) ? cout << "Number is Even" : cout << "Number is Odd";

    return 0;
}
